%% Acorde 2.0 — modelo conceitual proposto para o MVP; não implementado.
erDiagram
    ORGANIZACOES ||--o{ MEMBROS : possui
    USUARIOS ||--o{ MEMBROS : participa
    ORGANIZACOES ||--o{ ATIVIDADES_EMISSORAS : monitora
    MEMBROS ||--o{ ATIVIDADES_EMISSORAS : registra
    ATIVIDADES_EMISSORAS ||--o| DADOS_ENERGIA : detalha
    ATIVIDADES_EMISSORAS ||--o| DADOS_DESLOCAMENTO : detalha
    ATIVIDADES_EMISSORAS ||--o{ REGISTROS_EMISSAO : calcula
    FATORES_EMISSAO ||--o{ REGISTROS_EMISSAO : utiliza
    ORGANIZACOES ||--o{ METAS_CARBONO : define
    METAS_CARBONO ||--o{ ACOES_REDUCAO : organiza
    MEMBROS ||--o{ ACOES_REDUCAO : responsavel

    ORGANIZACOES {
        uuid id PK
        varchar nome
        timestamptz criado_em
    }
    USUARIOS {
        uuid id PK
        varchar nome
        varchar email UK
        varchar senha_hash
        boolean ativo
    }
    MEMBROS {
        uuid id PK
        uuid organizacao_id FK
        uuid usuario_id FK
        varchar papel
        boolean ativo
    }
    ATIVIDADES_EMISSORAS {
        uuid id PK
        uuid organizacao_id FK
        uuid membro_id FK
        varchar categoria
        date periodo_inicio
        date periodo_fim
        numeric quantidade
        varchar unidade
        varchar estado
        timestamptz criado_em
    }
    DADOS_ENERGIA {
        uuid atividade_id PK,FK
        numeric consumo_kwh
        varchar regiao_rede
    }
    DADOS_DESLOCAMENTO {
        uuid atividade_id PK,FK
        varchar modalidade
        numeric distancia_ida_volta_km
        numeric dias_viagens
        numeric ocupacao
    }
    FATORES_EMISSAO {
        uuid id PK
        varchar categoria
        varchar escopo
        numeric valor
        varchar unidade_atividade
        varchar unidade_resultado
        varchar fonte
        varchar versao
        date valido_desde
        date valido_ate
        varchar regiao
        text premissas
    }
    REGISTROS_EMISSAO {
        uuid id PK
        uuid atividade_id FK
        uuid fator_id FK
        numeric quantidade_aplicada
        numeric fator_aplicado
        numeric resultado_kg_co2e
        varchar unidade_resultado
        varchar estado
        boolean vigente
        timestamptz calculado_em
    }
    METAS_CARBONO {
        uuid id PK
        uuid organizacao_id FK
        varchar categoria
        date periodo_base_inicio
        date periodo_base_fim
        numeric valor_base_kg_co2e
        numeric reducao_alvo_percentual
        date prazo
        varchar estado
    }
    ACOES_REDUCAO {
        uuid id PK
        uuid meta_id FK
        uuid responsavel_membro_id FK
        varchar titulo
        text descricao
        date prazo
        varchar estado
    }
