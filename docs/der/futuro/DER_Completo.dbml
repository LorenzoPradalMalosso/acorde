// Acorde 2.0 — modelo conceitual para PostgreSQL.
// NÃO implementado. Validar fatores, escopos, RBAC e constraints antes de gerar migrações.
Project Acorde20 {
  database_type: 'PostgreSQL'
  Note: 'Proposta. O MVP monitora energia e deslocamento; outras fontes são expansão.'
}

Table organizacoes {
  id uuid [pk]
  nome varchar(160) [not null]
  criado_em timestamptz [not null, default: `now()`]
}

Table usuarios {
  id uuid [pk]
  nome varchar(160) [not null]
  email varchar(255) [not null, unique]
  senha_hash varchar(255) [not null, note: 'BCrypt/Argon2id; nunca texto puro']
  ativo boolean [not null, default: true]
  criado_em timestamptz [not null, default: `now()`]
}

Table membros {
  id uuid [pk]
  organizacao_id uuid [not null, ref: > organizacoes.id]
  usuario_id uuid [not null, ref: > usuarios.id]
  papel varchar(20) [not null, note: 'GESTOR | COLABORADOR']
  ativo boolean [not null, default: true]
  ingressou_em timestamptz [not null, default: `now()`]
  indexes {
    (organizacao_id, usuario_id) [unique]
    (organizacao_id, id) [unique]
  }
}

Table atividades_emissoras {
  id uuid [pk]
  organizacao_id uuid [not null, ref: > organizacoes.id]
  membro_id uuid [not null, ref: > membros.id]
  categoria varchar(40) [not null, note: 'ENERGIA_ELETRICA | DESLOCAMENTO | expansões futuras']
  periodo_inicio date [not null]
  periodo_fim date [not null]
  quantidade numeric(14,4) [note: 'Revisar possível redundância com detalhes tipados']
  unidade varchar(40)
  estado varchar(24) [not null, note: 'RASCUNHO | PENDENTE | CALCULADA | INVALIDADA']
  criado_em timestamptz [not null, default: `now()`]
  atualizado_em timestamptz [not null, default: `now()`]
  indexes {
    (organizacao_id, categoria, periodo_inicio)
    (membro_id, periodo_inicio)
  }
}

Table dados_energia {
  atividade_id uuid [pk, ref: - atividades_emissoras.id]
  consumo_kwh numeric(14,4) [not null]
  regiao_rede varchar(100) [not null, note: 'Granularidade mínima necessária ao fator; sem endereço']
}

Table dados_deslocamento {
  atividade_id uuid [pk, ref: - atividades_emissoras.id]
  modalidade varchar(40) [not null]
  distancia_ida_volta_km numeric(12,3) [not null]
  dias_viagens numeric(8,2) [not null]
  ocupacao numeric(6,2) [note: 'Quando exigida por fator veículo-km/alocação por passageiro']
}

Table fatores_emissao {
  id uuid [pk]
  codigo varchar(80) [not null]
  categoria varchar(40) [not null]
  escopo varchar(20) [not null, note: 'Ex.: ESCOPO_2, ESCOPO_3_CAT_7']
  valor numeric(18,8) [not null]
  unidade_atividade varchar(50) [not null]
  unidade_resultado varchar(50) [not null, note: 'MVP: kg CO2e']
  fonte varchar(255) [not null]
  versao varchar(100) [not null]
  valido_desde date [not null]
  valido_ate date
  regiao varchar(100) [not null]
  premissas text
  criado_em timestamptz [not null, default: `now()`]
  indexes {
    (codigo, versao) [unique]
    (categoria, regiao, valido_desde)
  }
  Note: 'Versões imutáveis; corrigir fator criando nova versão, sem reescrever cálculo histórico.'
}

Table registros_emissao {
  id uuid [pk]
  atividade_id uuid [not null, ref: > atividades_emissoras.id]
  fator_id uuid [ref: > fatores_emissao.id, note: 'Nulo se cálculo pendente sem fator aplicável']
  quantidade_aplicada numeric(14,4)
  unidade_aplicada varchar(50)
  fator_aplicado numeric(18,8)
  unidade_resultado varchar(50)
  resultado_kg_co2e numeric(18,6)
  estado varchar(24) [not null, note: 'PENDENTE | VALIDO | SUBSTITUIDO | INVALIDO']
  motivo_pendencia text
  vigente boolean [not null, default: false]
  calculado_em timestamptz [not null, default: `now()`]
  indexes {
    (atividade_id, calculado_em)
  }
  Note: 'Constraint parcial no PostgreSQL deve limitar uma revisão vigente por atividade. Somente cálculos válidos vigentes entram nos totais.'
}

Table metas_carbono {
  id uuid [pk]
  organizacao_id uuid [not null, ref: > organizacoes.id]
  categoria varchar(40) [note: 'Nulo = fontes selecionadas cobertas pela metodologia definida']
  periodo_base_inicio date [not null]
  periodo_base_fim date [not null]
  valor_base_kg_co2e numeric(18,6) [not null]
  reducao_alvo_percentual numeric(7,4) [not null]
  prazo date [not null]
  estado varchar(24) [not null, note: 'RASCUNHO | ATIVA | CONCLUIDA | CANCELADA']
  criado_em timestamptz [not null, default: `now()`]
}

Table acoes_reducao {
  id uuid [pk]
  meta_id uuid [not null, ref: > metas_carbono.id]
  responsavel_membro_id uuid [not null, ref: > membros.id]
  titulo varchar(180) [not null]
  descricao text
  prazo date
  estado varchar(24) [not null, note: 'A_FAZER | EM_ANDAMENTO | CONCLUIDA | CANCELADA']
  criado_em timestamptz [not null, default: `now()`]
  atualizado_em timestamptz [not null, default: `now()`]
}

// Expansões: cada detalhe pertence a uma atividade emissora da categoria correspondente.
Table dados_combustivel_frota {
  atividade_id uuid [pk, ref: - atividades_emissoras.id]
  tipo_combustivel varchar(60) [not null]
  quantidade numeric(14,4) [not null]
  unidade varchar(40) [not null]
}

Table dados_viagem_corporativa {
  atividade_id uuid [pk, ref: - atividades_emissoras.id]
  modalidade varchar(40) [not null]
  distancia_km numeric(14,3) [not null]
  classe varchar(40)
  passageiros numeric(8,2)
}

Table dados_materiais_residuos {
  atividade_id uuid [pk, ref: - atividades_emissoras.id]
  material varchar(80) [not null]
  quantidade numeric(14,4) [not null]
  unidade varchar(40) [not null]
  destino varchar(80)
}

Table notificacoes_ambientais {
  id uuid [pk]
  membro_id uuid [not null, ref: > membros.id]
  meta_id uuid [ref: > metas_carbono.id]
  atividade_id uuid [ref: > atividades_emissoras.id]
  tipo varchar(40) [not null]
  mensagem text [not null]
  criada_em timestamptz [not null, default: `now()`]
  lida_em timestamptz
}
