# Configuração local de desenvolvimento. Não use estes valores fora da máquina local.
POSTGRES_DB=acorde
POSTGRES_USER=acorde
POSTGRES_PASSWORD=acorde_local
POSTGRES_PORT=5433

DB_URL=jdbc:postgresql://localhost:5433/acorde
DB_USERNAME=acorde
DB_PASSWORD=acorde_local

# O script gera e persiste uma chave aleatória quando este campo está vazio/inválido.
JWT_SECRET_BASE64=
ACORDE_DEMO_PASSWORD=admin1245678
SERVER_PORT=8080
VITE_API_BASE_URL=/api
